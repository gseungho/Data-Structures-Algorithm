# 파이썬 캐시 폴더와 파일들
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# 가상환경 폴더 (venv, env 등 쓰는 경우)
venv/
env/
.venv/
.env/

# VS Code 설정 폴더
.vscode/

# 파이썬 패키지 관련
*.egg-info/
dist/
build/
*.egg

# 기타 불필요한 것들
.DS_Store           # macOS에서 생기는 파일
Thumbs.db           # Windows에서 생기는 파일
*.log               # 로그 파일